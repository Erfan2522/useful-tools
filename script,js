}


function updatePasswordLength() {

    const slider =
        document.getElementById("passwordLength");

    document.getElementById("passwordLengthValue")
        .textContent = slider.value;

    generatePassword();
}


function randomCharacter(chars) {

    const array =
        new Uint32Array(1);

    crypto.getRandomValues(array);

    return chars[array[0] % chars.length];
}


function shuffleString(string) {

    const array =
        string.split("");

    for (let i = array.length - 1; i > 0; i--) {

        const random =
            new Uint32Array(1);

        crypto.getRandomValues(random);

        const j =
            random[0] % (i + 1);

        [array[i], array[j]] =
            [array[j], array[i]];
    }

    return array.join("");
}


function generatePassword() {

    const length =
        Number(
            document.getElementById("passwordLength").value
        );

    const upper =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    const lower =
        "abcdefghijklmnopqrstuvwxyz";

    const numbers =
        "0123456789";

    const symbols =
        "!@#$%^&*()_+-=[]{}|;:,.<>?";


    const selected = [];

    let all = "";


    if (document.getElementById("includeUppercase").checked) {

        selected.push(upper);

        all += upper;
    }

    if (document.getElementById("includeLowercase").checked) {

        selected.push(lower);

        all += lower;
    }

    if (document.getElementById("includeNumbers").checked) {

        selected.push(numbers);

        all += numbers;
    }

    if (document.getElementById("includeSymbols").checked) {

        selected.push(symbols);

        all += symbols;
    }


    const output =
        document.getElementById("generatedPassword");


    if (!all) {

        output.value =
            currentLanguage === "fa"
                ? "حداقل یک گزینه را انتخاب کنید"
                : "Select at least one option";

        return;
    }


    let password = "";


    selected.forEach(set => {

        password += randomCharacter(set);

    });


    while (password.length < length) {

        password += randomCharacter(all);

    }


    password =
        shuffleString(password)
        .substring(0, length);


    output.value = password;

    updatePasswordStrength(password);
}


function updatePasswordStrength(password) {

    const text =
        document.getElementById("strengthText");

    const progress =
        document.getElementById("strengthProgress");


    if (!password) {

        text.textContent = "-";

        progress.style.width = "0%";

        return;
    }


    let score = 0;


    if (password.length >= 8)
        score++;

    if (password.length >= 12)
        score++;

    if (/[A-Z]/.test(password))
        score++;

    if (/[a-z]/.test(password))
        score++;

    if (/[0-9]/.test(password))
        score++;

    if (/[^A-Za-z0-9]/.test(password))
        score++;


    if (score <= 2) {

        progress.style.width = "30%";

        text.textContent =
            currentLanguage === "fa"
                ? "ضعیف"
                : "Weak";

    } else if (score <= 4) {

        progress.style.width = "65%";

        text.textContent =
            currentLanguage === "fa"
                ? "متوسط"
                : "Medium";

    } else {

        progress.style.width = "100%";

        text.textContent =
            currentLanguage === "fa"
                ? "قوی"
                : "Strong";
    }
}


async function copyPassword() {

    const input =
        document.getElementById("generatedPassword");

    if (!input.value)
        return;

    await navigator.clipboard.writeText(input.value);

    const button =
        document.querySelector(".copy-password");

    const old =
        button.textContent;

    button.textContent = "✅";

    setTimeout(() => {

        button.textContent = old;

    }, 1200);
}


[
    "includeUppercase",
    "includeLowercase",
    "includeNumbers",
    "includeSymbols"
].forEach(id => {

    document.getElementById(id)
        .addEventListener(
            "change",
            generatePassword
        );

});


/* =========================================
   CALCULATOR
========================================= */

let calcExpression = "";


function calcInput(value) {

    if (calcExpression === "Error")
        calcExpression = "";

    calcExpression += value;

    document.getElementById("calcDisplay")
        .value = calcExpression;
}


function calcClear() {

    calcExpression = "";

    document.getElementById("calcDisplay")
        .value = "0";
}


function calcDelete() {

    calcExpression =
        calcExpression.slice(0,-1);

    document.getElementById("calcDisplay")
        .value =
        calcExpression || "0";
}


function calcCalculate() {

    try {

        let expression =
            calcExpression.replaceAll("%","/100");

        if (!/^[0-9+\-*/().\s]+$/.test(expression))
            throw new Error();

        const result =
            Function(
                '"use strict"; return (' +
                expression +
                ')'
            )();

        calcExpression =
            String(result);

        document.getElementById("calcDisplay")
            .value = calcExpression;

    } catch {

        calcExpression = "Error";

        document.getElementById("calcDisplay")
            .value = "Error";
    }
}


