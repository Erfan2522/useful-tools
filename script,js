        text.trim()
            ? text.trim().split(/\s+/).length
            : 0;

    const lines =
        text
            ? text.split("\n").length
            : 0;


    document.getElementById("charCount")
        .textContent = chars;

    document.getElementById("wordCount")
        .textContent = words;

    document.getElementById("lineCount")
        .textContent = lines;
}


/* =========================================
   UNIT CONVERTER
========================================= */

const units = {

    length: {

        meter: 1,

        kilometer: 1000,

        centimeter: .01,

        millimeter: .001,

        mile: 1609.344,

        foot: .3048

    },

    weight: {

        kilogram: 1,

        gram: .001,

        pound: .45359237,

        ounce: .0283495

    },

    temperature: {

        celsius: "celsius",

        fahrenheit: "fahrenheit",

        kelvin: "kelvin"

    }

};


function setupUnits() {

    const type =
        document.getElementById("unitType").value;

    const from =
        document.getElementById("unitFrom");

    const to =
        document.getElementById("unitTo");


    const list =
        Object.keys(units[type]);


    from.innerHTML = "";

    to.innerHTML = "";


    list.forEach(unit => {

        const option1 =
            document.createElement("option");

        const option2 =
            document.createElement("option");

        option1.value = unit;

        option2.value = unit;

        option1.textContent =
            unit;

        option2.textContent =
            unit;

        from.appendChild(option1);

        to.appendChild(option2);

    });


    if (list.length > 1)
        to.value = list[1];

    convertUnit();
}


function convertUnit() {

    const type =
        document.getElementById("unitType").value;

    const input =
        Number(
            document.getElementById("unitInput").value
        );

    const from =
        document.getElementById("unitFrom").value;

    const to =
        document.getElementById("unitTo").value;


    if (!from || !to)
        return;


    let result;


    if (type === "temperature") {

        let celsius;


        if (from === "celsius")
            celsius = input;

        if (from === "fahrenheit")
            celsius = (input - 32) * 5 / 9;

        if (from === "kelvin")
            celsius = input - 273.15;


        if (to === "celsius")
            result = celsius;

        if (to === "fahrenheit")
            result = celsius * 9 / 5 + 32;

        if (to === "kelvin")
            result = celsius + 273.15;

    } else {

        const base =
            input * units[type][from];

        result =
            base / units[type][to];
    }


    document.getElementById("unitResult")
        .textContent =
        Number(result.toFixed(8));
}


document.getElementById("unitType")
    .addEventListener("change", setupUnits);


/* =========================================
   COLOR PICKER
========================================= */

function hexToRgb(hex) {

    const value =
        hex.replace("#","");

    const bigint =
        parseInt(value,16);

    return {

        r: (bigint >> 16) & 255,

        g: (bigint >> 8) & 255,

        b: bigint & 255

    };
}


function updateColor() {

    const color =
        document.getElementById("mainColorPicker")
            .value;

    const rgb =
        hexToRgb(color);


    document.getElementById("colorPreview")
        .style.background = color;

    document.getElementById("hexValue")
        .textContent = color.toUpperCase();

    document.getElementById("rgbValue")
        .textContent =
        `${rgb.r}, ${rgb.g}, ${rgb.b}`;
}


async function copyColor() {

    const color =
        document.getElementById("mainColorPicker")
            .value;

    await navigator.clipboard.writeText(color);

}


/* =========================================
   TIMER / STOPWATCH
========================================= */

let timerSeconds = 0;

let timerInterval = null;


function formatTime(seconds) {

    const hours =
        Math.floor(seconds / 3600);

    const minutes =
        Math.floor((seconds % 3600) / 60);

    const secs =
        seconds % 60;


    return [

        hours,
        minutes,
        secs

    ]
    .map(value =>
        String(value).padStart(2,"0")
    )
    .join(":");
}


function updateTimerDisplay() {

    document.getElementById("timerDisplay")
        .textContent =
        formatTime(timerSeconds);
}


function startTimer() {

    if (timerInterval)
        return;


    timerInterval =
        setInterval(() => {

            timerSeconds++;

            updateTimerDisplay();

        },1000);
}


function stopTimer() {

    clearInterval(timerInterval);

    timerInterval = null;
}


function resetTimer() {

    stopTimer();

    timerSeconds = 0;

    updateTimerDisplay();
}


